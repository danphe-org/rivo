# ==============================================================================
# Application & Server Configuration
# ==============================================================================
APP_NAME=rivo
APP_ENV=development
CLIENT_FE_URL=http://localhost:3000

# Server Ports
SERVER_PORT_CLIENT=8022
SERVER_PORT_SYSTEM=8021

# ==============================================================================
# Database Configuration (PostgreSQL & HikariCP)
# ==============================================================================
DB_URL=jdbc:postgresql://89.117.56.195:2345/rivo_dev?stringtype=unspecified
DB_USERNAME=danphe
DB_PASSWORD=Asd@78qwe
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# ==============================================================================
# Database Migrations (Flyway)
# ==============================================================================
FLYWAY_ENABLED=true
FLYWAY_SCHEMAS=client,system,public
FLYWAY_DEFAULT_SCHEMA=system
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# ==============================================================================
# Security & JWT Configuration
# ==============================================================================
JWT_SECRET=rivo-super-secret-jwt-key-must-be-at-least-256-bits-long-secure!
JWT_ACCESS_TOKEN_EXPIRY_MS=86400000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
JWT_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

# ==============================================================================
# SMTP Mail Configuration
# ==============================================================================
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@example.com
